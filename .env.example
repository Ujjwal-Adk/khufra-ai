# ═══ Khufra Trading System v2.0 - Environment Variables ═══
# Copy to .env and fill in your values. NEVER commit .env to git!
# Strategy params are in config/settings.yaml — only SECRETS go here.

# ── Bitget API (Trade permission ONLY — never withdrawal) ──
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# ── Telegram Notifications ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI Advisor (Optional — set ai_advisor.enabled in settings.yaml) ──
ANTHROPIC_API_KEY=

# ── On-Chain Data (Phase 3) ──
WHALE_ALERT_API_KEY=
GLASSNODE_API_KEY=

# ── Database (optional — defaults to SQLite in data_store/) ──
# DATABASE_URL=sqlite:///data_store/trades.db
# For PostgreSQL: postgresql://user:password@localhost:5432/khufra
