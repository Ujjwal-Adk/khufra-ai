# Project Khufra AI - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to GitHub!

# ============================================
# EXCHANGE API CREDENTIALS
# ============================================
# Bitget API Keys (get from: https://www.bitget.com/api-doc)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_API_PASSWORD=your_bitget_api_password_here

# Binance API Keys (backup exchange - optional)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ============================================
# AI INTEGRATION
# ============================================
# Claude AI API Key (get from: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# NOTIFICATIONS
# ============================================
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID_UJJWAL=your_ujjwal_chat_id_here
TELEGRAM_CHAT_ID_ANJING=your_anjing_chat_id_here

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ============================================
# NEWS APIS
# ============================================
# NewsAPI.org (get from: https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage (get from: https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ============================================
# DATABASE
# ============================================
# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///data/trades.db
# For PostgreSQL: postgresql://user:password@localhost:5432/khufra_ai

# ============================================
# BOT CONFIGURATION
# ============================================
# Trading Mode: 'paper' or 'live' (ALWAYS start with paper!)
TRADING_MODE=paper

# Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# RISK MANAGEMENT
# ============================================
# Maximum risk per trade (as decimal, e.g., 0.02 = 2%)
MAX_RISK_PER_TRADE=0.02

# Daily loss limit (as decimal, e.g., 0.05 = 5%)
DAILY_LOSS_LIMIT=0.05

# Monthly loss limit (as decimal, e.g., 0.15 = 15%)
MONTHLY_LOSS_LIMIT=0.15

# Maximum concurrent positions
MAX_CONCURRENT_POSITIONS=3

# ============================================
# TRADINGVIEW
# ============================================
# TradingView webhook secret (for receiving alerts)
TRADINGVIEW_WEBHOOK_SECRET=your_tradingview_webhook_secret_here

# ============================================
# SECURITY
# ============================================
# Secret key for encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_a_secure_random_key_here

# ============================================
# OPTIONAL SETTINGS
# ============================================
# Enable/disable specific features
ENABLE_NEWS_MONITORING=true
ENABLE_TRADINGVIEW_SIGNALS=true
ENABLE_AI_DECISIONS=true
ENABLE_TELEGRAM_NOTIFICATIONS=true
ENABLE_DISCORD_NOTIFICATIONS=false

# Timezone (for logging and scheduling)
TIMEZONE=America/Edmonton

# API Rate Limiting (requests per minute)
API_RATE_LIMIT=60
